title: $:/plugins/pankesh/myTiddlyEncryption/styles
tags: $:/tags/Stylesheet
type: text/css

/* ── Locked notice (shown in tiddler body when encrypted) ── */
.tiddlyencrypt-locked-notice {
  display: flex;
  align-items: center;
  gap: 0.75em;
  padding: 0.6em 0.8em;
  margin: 0.25em 0;
  background: #fffbe6;
  border: 1px solid #f0c040;
  border-radius: 4px;
  font-style: italic;
  color: #666;
}

.tiddlyencrypt-lock-icon {
  flex: 1;
}

/* ── Shared button styles ── */
.tiddlyencrypt-decrypt-btn,
.tiddlyencrypt-decryptall-btn,
.tiddlyencrypt-changepw-btn {
  display: inline-block;
  padding: 3px 10px;
  border: 1px solid #aaa;
  border-radius: 3px;
  background: #f5f5f5;
  cursor: pointer;
  font-size: 0.85em;
  font-style: normal;
  white-space: nowrap;
}

.tiddlyencrypt-decrypt-btn:hover,
.tiddlyencrypt-decryptall-btn:hover,
.tiddlyencrypt-changepw-btn:hover {
  background: #e0e0e0;
  border-color: #888;
}

/* ── Decrypted content wrapper ── */
.tiddlyencrypt-decrypted-content {
  /* No special styling — looks like a normal tiddler body */
}

/* ── Two-field password confirmation modal ── */
.tiddlyencrypt-modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tiddlyencrypt-modal-box {
  background: #fff;
  border: 1px solid #ccc;
  border-radius: 6px;
  padding: 1.5em 2em;
  min-width: 300px;
  max-width: 420px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.2);
  display: flex;
  flex-direction: column;
  gap: 0.75em;
}

.tiddlyencrypt-modal-title {
  margin: 0 0 0.25em;
  font-size: 1.1em;
  font-weight: bold;
}

.tiddlyencrypt-modal-box label {
  display: flex;
  flex-direction: column;
  gap: 0.25em;
  font-size: 0.9em;
}

.tiddlyencrypt-modal-input {
  padding: 0.4em 0.6em;
  border: 1px solid #ccc;
  border-radius: 3px;
  font-size: 1em;
  width: 100%;
  box-sizing: border-box;
}

.tiddlyencrypt-modal-input:focus {
  outline: 2px solid #6699cc;
  border-color: #6699cc;
}

.tiddlyencrypt-modal-error {
  color: #c0392b;
  font-size: 0.85em;
  margin: 0;
  padding: 0.3em 0.5em;
  background: #fdf0ee;
  border-radius: 3px;
  border: 1px solid #e8b4ae;
}

.tiddlyencrypt-modal-buttons {
  display: flex;
  gap: 0.5em;
  justify-content: flex-end;
  margin-top: 0.25em;
}

.tiddlyencrypt-modal-submit,
.tiddlyencrypt-modal-cancel {
  padding: 0.4em 1.1em;
  border-radius: 3px;
  cursor: pointer;
  font-size: 0.9em;
  border: 1px solid #aaa;
}

.tiddlyencrypt-modal-submit {
  background: #5b8dd9;
  color: #fff;
  border-color: #4a7bc8;
  font-weight: bold;
}

.tiddlyencrypt-modal-submit:hover { background: #4a7bc8; }

.tiddlyencrypt-modal-cancel {
  background: #f5f5f5;
}

.tiddlyencrypt-modal-cancel:hover { background: #e0e0e0; }
